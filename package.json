{
  "name": "medeo-plugins",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Medeo desktop plugins",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test plugins/*/tests/*.test.mjs scripts/*.test.mjs",
    "pack": "node scripts/pack-all.mjs",
    "verify": "npm run typecheck && npm test && npm run pack",
    "release:list": "node scripts/release-plugins.mjs list"
  },
  "devDependencies": {
    "@medeo-plugin/cli": "0.9.2",
    "@medeo-plugin/sdk": "0.9.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
