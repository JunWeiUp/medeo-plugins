{
  "id": "app.medeo.screenshot",
  "name": "Screenshot & Recorder",
  "description": "Capture screenshots and 120Hz multi-track screen recordings with system audio, microphone, camera, click highlights, keystrokes, annotations, pin-to-screen, OCR and Issue packaging.",
  "icon": "icon.svg",
  "version": "2.0.0",
  "api_version": 1,
  "runtime": "node",
  "platforms": [
    "macos"
  ],
  "worker": "main.mjs",
  "permissions": [
    "node",
    "app_windows",
    "window_management",
    "screen_capture",
    "microphone",
    "system_audio",
    "camera",
    "global_shortcuts",
    "tray",
    "notifications",
    "plugin_commands"
  ],
  "activation_events": [
    "onStartup"
  ],
  "commands": [
    {
      "id": "screenshot.capture",
      "title": "Capture Area"
    },
    {
      "id": "screenshot.record",
      "title": "Record Screen (120Hz)"
    },
    {
      "id": "screenshot.record-issue",
      "title": "Record Issue (120Hz + Telemetry)"
    },
    {
      "id": "screenshot.record-stop",
      "title": "Stop Recording"
    },
    {
      "id": "screenshot.history",
      "title": "Recent Recordings"
    },
    {
      "id": "screenshot.capture-full",
      "title": "Capture Full Screen"
    },
    {
      "id": "screenshot.capture-quick",
      "title": "Quick Capture"
    },
    {
      "id": "screenshot.capture-ocr",
      "title": "Capture Text (OCR)"
    },
    {
      "id": "screenshot.settings",
      "title": "Screenshot & Recorder Settings"
    },
    {
      "id": "screenshot.folder",
      "title": "Open Captures Folder"
    }
  ],
  "localization": {
    "default_locale": "en",
    "catalogs": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json",
      "zh-TW": "locales/zh-TW.json"
    }
  },
  "contributes": {
    "launcher": {
      "keyword": "shot",
      "commands": [
        {
          "command": "screenshot.capture",
          "pinnable": true,
          "keywords": [
            "screenshot",
            "capture",
            "area",
            "截图",
            "截屏"
          ]
        },
        {
          "command": "screenshot.record",
          "pinnable": true,
          "keywords": [
            "record",
            "screen",
            "video",
            "120hz",
            "gif",
            "录屏",
            "录制"
          ]
        },
        {
          "command": "screenshot.record-issue",
          "pinnable": true,
          "keywords": [
            "issue",
            "bug",
            "record",
            "mearc",
            "问题录屏",
            "复现"
          ]
        },
        {
          "command": "screenshot.record-stop",
          "keywords": [
            "stop",
            "record",
            "停止录屏"
          ]
        },
        {
          "command": "screenshot.history",
          "keywords": [
            "history",
            "recordings",
            "review",
            "录屏历史",
            "最近录制"
          ]
        },
        {
          "command": "screenshot.capture-full",
          "keywords": [
            "screenshot",
            "full screen",
            "全屏",
            "截图"
          ]
        },
        {
          "command": "screenshot.capture-quick",
          "keywords": [
            "screenshot",
            "quick",
            "快速",
            "截图"
          ]
        },
        {
          "command": "screenshot.capture-ocr",
          "pinnable": true,
          "keywords": [
            "ocr",
            "text",
            "qr",
            "识字",
            "文字识别",
            "二维码"
          ]
        },
        {
          "command": "screenshot.folder",
          "keywords": [
            "screenshot",
            "folder",
            "截图",
            "录屏",
            "文件夹"
          ]
        },
        {
          "command": "screenshot.settings",
          "keywords": [
            "screenshot",
            "recorder",
            "settings",
            "截图",
            "录屏",
            "设置"
          ]
        }
      ]
    }
  }
}
