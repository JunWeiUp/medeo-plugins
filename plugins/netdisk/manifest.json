{
  "id": "app.medeo.netdisk",
  "name": "Netdisk",
  "description": "Browse your Medeo Drive folders: store files by dragging them in, take them out by dragging them to Finder, rename, delete and see each file's sync state.",
  "icon": "icon.svg",
  "version": "1.2.0",
  "api_version": 1,
  "engines": {
    "medeo": ">=0.1.46"
  },
  "platforms": [
    "macos"
  ],
  "worker": "worker.js",
  "ui": "ui/index.html",
  "permissions": [
    "storage",
    "app_windows",
    "notifications",
    "drive_read",
    "drive_manage",
    {
      "file_access": []
    }
  ],
  "commands": [
    {
      "id": "netdisk.store",
      "title": "Store to Medeo Drive"
    },
    {
      "id": "netdisk.store-to",
      "title": "Store to Medeo Drive…"
    }
  ],
  "localization": {
    "default_locale": "en",
    "catalogs": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json",
      "zh-TW": "locales/zh-TW.json"
    }
  },
  "contributes": {
    "launcher": {
      "commands": [
        {
          "command": "netdisk.store",
          "accepts": [
            "file",
            "image",
            "text",
            "url"
          ],
          "keywords": [
            "drive",
            "cloud",
            "save"
          ]
        },
        {
          "command": "netdisk.store-to",
          "accepts": [
            "file",
            "image",
            "text",
            "url"
          ],
          "keywords": [
            "drive",
            "cloud",
            "save"
          ]
        }
      ]
    }
  }
}
