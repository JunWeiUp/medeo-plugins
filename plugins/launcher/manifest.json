{
  "id": "app.medeo.launcher",
  "name": "Launcher",
  "description": "Press ⌥Space to open apps, run any plugin's commands and results, calculate and convert units from one search box.",
  "icon": "icon.svg",
  "version": "1.2.1",
  "api_version": 1,
  "engines": {
    "medeo": ">=0.1.33"
  },
  "platforms": [
    "macos"
  ],
  "worker": "worker.js",
  "permissions": [
    "applications",
    "plugin_commands",
    "app_windows",
    "clipboard_write",
    "storage"
  ],
  "commands": [
    {
      "id": "launcher.toggle",
      "title": "Open Launcher"
    }
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "launcher.toggle",
        "key": "Alt+Space"
      }
    ],
    "menus": {
      "app": [
        "launcher.toggle"
      ]
    }
  },
  "localization": {
    "default_locale": "en",
    "catalogs": {
      "en": "locales/en.json",
      "zh-CN": "locales/zh-CN.json",
      "zh-TW": "locales/zh-TW.json"
    }
  }
}
